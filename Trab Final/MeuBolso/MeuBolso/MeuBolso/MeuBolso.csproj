<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeuBolso</RootNamespace>
    <AssemblyName>MeuBolso</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Biblioteca do SQLite (baixada automaticamente pelo Visual Studio via NuGet) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copia o script do banco para a pasta do .exe; o programa o executa na primeira vez -->
    <None Include="..\database\meubolso.sql" Link="meubolso.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
